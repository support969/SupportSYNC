# Apify API token: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Google service account credentials: either a path to the JSON key file
# or the raw JSON itself. Share the sheet with the service account's email.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# The ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Optional: tab name to write to (created if missing)
GOOGLE_SHEET_TAB=Leads

# Optional: override which Apify actors are used
# APIFY_SEARCH_ACTOR=apify/google-search-scraper
# APIFY_PAGES_ACTOR=apify/facebook-pages-scraper
